# Version control
.git/
.gitignore

# Tests
tests/

# Virtual environments
.venv/
venv/

# Runtime data (mounted as volume)
data/

# Secrets — never ship the secret-bearing .env into the build context (OVH-145)
.env
.env.*
!.env.example

# CI/CD and automation
.github/
.claude-runner/
.claude/

# Python caches
__pycache__/
*.pyc
*.pyo

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Documentation (keep README.md for hatchling metadata; THIRD_PARTY_NOTICES.md
# is copied into the image at /usr/share/licenses/topic-watch/ — AUG-341)
docs/
*.md
!README.md
!THIRD_PARTY_NOTICES.md

# Dev tooling configs
.pre-commit-config.yaml
Makefile

# Scripts
scripts/

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db
