# Topic Watch — runtime/Docker environment template.
# Copy to `.env` (which is gitignored) and adjust as needed.

# --- Container file permissions (native Linux bind mounts) ---
# Match the bind-mounted ./data ownership to your host user so the container
# can write the database/config. Defaults to 1000 (the typical first Linux
# user). If `id -u`/`id -g` on your host differ, set these to your UID/GID.
PUID=1000
PGID=1000

# --- Timezone ---
# Container timezone, e.g. Europe/Berlin or America/New_York. Affects timestamps
# shown in the UI and logs. Defaults to UTC.
TZ=UTC

# --- Web server ---
# Host port published on the host (the container always listens on 8000).
# Honored by both compose files. The installer writes your answer here.
TOPIC_WATCH_PORT=8000

# Host interface the port is published on.
#
#   127.0.0.1  this computer only (default)
#   0.0.0.0    any device on your network
#
# Topic Watch has no login screen, and Docker publishes ports ahead of
# ufw/firewalld rules — so 0.0.0.0 exposes it even on a host whose firewall
# denies incoming traffic. Use 0.0.0.0 only on a network you trust, and put an
# authenticating reverse proxy in front for anything beyond that (SECURITY.md).
TOPIC_WATCH_BIND_ADDR=127.0.0.1

# --- LLM configuration ---
# NOTE: Compose uses this file to fill in ${...} placeholders in the compose file
# — it does not hand the whole file to the container. Only names listed under
# `environment:` reach the app, and the LLM keys are not among them, so a key set
# here is ignored. Set your LLM provider + key in the setup wizard at
# http://localhost:8000 on first run, or add it under `environment:` yourself.
# The lines below are kept commented only as a reference for the names.
# TOPIC_WATCH_LLM__MODEL=openai/gpt-4o-mini
# TOPIC_WATCH_LLM__API_KEY=your-api-key-here

# --- Security (remote / public deployments) ---
# Only send cookies over HTTPS. Uncomment when serving behind a TLS reverse
# proxy (see SECURITY.md). Leave unset for plain-HTTP localhost use.
# TOPIC_WATCH_SECURE_COOKIES=true

# Hostnames Topic Watch answers to, comma-separated. Requests carrying any other
# Host header get a 400, which stops a hostile site from re-pointing its own
# domain at this machine and driving the console from your browser.
#
# localhost, *.localhost, *.local and any IP address are always accepted, so a
# stock install and LAN access over http://192.168.x.x:8000 need nothing here.
# Set this to the hostname your reverse proxy forwards (Caddy, and the Nginx
# example in SECURITY.md, both pass the user-facing name through).
# "*.example.com" covers the subdomains and the apex; "*" turns the check off.
# TOPIC_WATCH_ALLOWED_HOSTS=topic-watch.example.com

# --- Config file location (advanced / non-Docker use) ---
# Pins the config file, and therefore the data directory (config.yml and the
# database live together), to an explicit path — overrides Topic Watch's
# auto-detected location. Not wired into either compose file's `environment:`
# block, so setting it here has no effect on the container; relocate the
# container's data directory with TOPIC_WATCH_DB_PATH instead.
# TOPIC_WATCH_CONFIG_PATH=/path/to/config.yml
